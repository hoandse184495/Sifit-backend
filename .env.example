NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/sifit
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_SAME_SITE=lax
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESERVATION_EXPIRES_IN_MINUTES=15
PAYMENT_PROVIDER=simulator
PAYMENTS_ENABLED=true
# To receive real PayOS payments set PAYMENT_PROVIDER=payos, PAYMENT_MODE=production,
# then fill these keys locally. PayOS has no separate sandbox.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_WEBHOOK_URL=
PAYMENT_MODE=sandbox
PAYMENT_WEBHOOK_SECRET=
PAYMENT_RETURN_URL=http://localhost:5173/payment/result
PAYMENT_CANCEL_URL=http://localhost:5173/payment/cancel
PAYOUT_MODE=manual
PAYOUT_HOLD_DAYS=0
SHIPPING_PROVIDER=manual
SHIPPING_MODE=sandbox
SHIPPING_WEBHOOK_SECRET=
BUYER_PROTECTION_DAYS=3
SELLER_VERIFICATION_MODE=manual
REVIEW_EDIT_WINDOW_DAYS=7
SOCKET_IO_ENABLED=true
SOCKET_CORS_ORIGIN=http://localhost:5173
CHAT_MAX_MESSAGE_LENGTH=2000
CHAT_MAX_MESSAGES_PER_MINUTE=30
# Reads/polling and writes have independent budgets, keyed by verified user or IP.
RATE_LIMIT_READ_PER_MINUTE=600
RATE_LIMIT_WRITE_PER_MINUTE=120
NOTIFICATION_OUTBOX_BATCH_SIZE=100
NOTIFICATION_OUTBOX_RETRY_LIMIT=5
# Automatically start maintenance and notification jobs with npm start / npm run dev.
BACKGROUND_JOBS_ENABLED=true
BACKGROUND_MAINTENANCE_INTERVAL_SECONDS=60
BACKGROUND_NOTIFICATION_INTERVAL_SECONDS=15
BACKGROUND_JOB_BATCH_SIZE=20
COMMISSION_RATE=10
