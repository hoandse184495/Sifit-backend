{
  "name": "sifit-backend",
  "version": "1.0.0",
  "description": "Backend foundation for SIFIT, a C2C second-hand fashion marketplace.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "jest --runInBand",
    "lint": "eslint .",
    "format": "prettier --write .",
    "seed:categories": "node scripts/seedCategories.js",
    "worker:expire-reservations": "node src/workers/reservationExpiry.worker.js",
    "worker:reconcile-payments": "node src/workers/paymentReconciliation.worker.js",
    "worker:evaluate-payouts": "node src/workers/payoutEligibility.worker.js",
    "worker:process-payouts": "node src/workers/payoutProcessing.worker.js",
    "worker:reconcile-shipments": "node src/workers/shipmentReconciliation.worker.js",
    "worker:complete-deliveries": "node src/workers/deliveryCompletion.worker.js",
    "worker:dispute-deadlines": "node src/workers/disputeDeadline.worker.js",
    "worker:notification-outbox": "node src/workers/notificationOutbox.worker.js",
    "migrate:roles": "node scripts/upgradeRoles.js"
  },
  "keywords": [
    "sifit",
    "marketplace",
    "express",
    "mongodb",
    "mongoose"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "argon2": "^0.44.0",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.2",
    "morgan": "^1.10.1",
    "multer": "^2.4.0",
    "socket.io": "^4.8.4",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.1.4"
  },
  "overrides": {
    "sprintf-js": "1.1.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
