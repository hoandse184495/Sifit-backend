# Copy to deploy/.env. Keep this file private; do not reuse your local .env.
DOMAIN=sifit.example.com
RELEASE_TAG=demo-1
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR_CLUSTER/sifit_demo
FRONTEND_URL=https://sifit.example.com
SOCKET_CORS_ORIGIN=https://sifit.example.com
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PAYMENT_WEBHOOK_SECRET=
SHIPPING_WEBHOOK_SECRET=
REFRESH_COOKIE_SAME_SITE=lax
PAYMENT_PROVIDER=payos
PAYMENTS_ENABLED=false
PAYMENT_MODE=production
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_WEBHOOK_URL=
PAYOUT_MODE=manual
SHIPPING_PROVIDER=manual
SHIPPING_MODE=production
SELLER_VERIFICATION_MODE=manual
GOOGLE_CLIENT_ID=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
BACKGROUND_JOBS_ENABLED=true
SOCKET_IO_ENABLED=true
